{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "coopverse",
  "compatibility_date": "2026-05-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "coopverse"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://coopverse.io",
    "NEXT_PUBLIC_PIKOPARK_URL": "https://pikopark-online.vercel.app",
    "NEXT_PUBLIC_ADSENSE_PUB_ID": "ca-pub-5335855577404641"
  },
  "routes": [
    { "pattern": "coopverse.io/*", "zone_name": "coopverse.io" },
    { "pattern": "www.coopverse.io/*", "zone_name": "coopverse.io" }
  ]
}
