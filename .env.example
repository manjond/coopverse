# Coopverse — environment variables template
#
# Copy this to .env.local and fill in real values. .env.local is gitignored
# so secrets stay out of the repo. Never commit a file with real values.

# ─── Database (Neon Postgres) ─────────────────────────────────────────────
# Get this from Neon dashboard → your project → Connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/coopverse?sslmode=require

# ─── Auth (JWT secret — generate a random 32+ char string) ───────────────
AUTH_SECRET=change-me-to-a-long-random-secret

# ─── Google AdSense ───────────────────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUB_ID=ca-pub-...

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────
# Get from clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ─── Email (Resend) — added later ─────────────────────────────────────────
# RESEND_API_KEY=re_...

# ─── Admin panel password (Step 12) ───────────────────────────────────────
# A long random string. Used to gate /admin while we don't have real auth.
ADMIN_PASSWORD=change-me-to-something-long-and-random

# ─── Public site URL (used for sitemap/canonical/og tags) ─────────────────
NEXT_PUBLIC_SITE_URL=https://coopverse.io
